# Expression body for lambdas
dotnet_diagnostic.IDE0053.severity = none
# Expression value is never used
dotnet_diagnostic.IDE0058.severity = none
# Add missing switch cases (expression)
dotnet_diagnostic.IDE0072.severity = none
# Use coalesce expression
dotnet_diagnostic.IDE0270.severity = none
# Use primary constructor
dotnet_diagnostic.IDE0290.severity = none

#### .NET Code Analysis (CAxxxx) ####
# AnalysisMode=All enables every rule; these are disabled as noise for an
# ASP.NET Core application. Security, reliability and nullable rules stay on.

# Do not declare static members on generic types
dotnet_diagnostic.CA1000.severity = none
# Do not expose generic lists
dotnet_diagnostic.CA1002.severity = none
# Enums should have zero value
dotnet_diagnostic.CA1008.severity = none
# Define accessors for attribute arguments
dotnet_diagnostic.CA1019.severity = none
# Use properties where appropriate
dotnet_diagnostic.CA1024.severity = none
# Use events where appropriate
dotnet_diagnostic.CA1030.severity = none
# Do not catch general exception types
dotnet_diagnostic.CA1031.severity = none
# Implement standard exception constructors
dotnet_diagnostic.CA1032.severity = none
# Nested types should not be visible
dotnet_diagnostic.CA1034.severity = none
# Avoid empty interfaces (marker interfaces)
dotnet_diagnostic.CA1040.severity = none
# Do not declare visible instance fields
dotnet_diagnostic.CA1051.severity = none
# URI-like properties should not be strings
dotnet_diagnostic.CA1056.severity = none
# Validate arguments (covered by nullable reference types)
dotnet_diagnostic.CA1062.severity = none
# Specify StringComparison for clarity
dotnet_diagnostic.CA1307.severity = none
# Normalize strings to uppercase
dotnet_diagnostic.CA1308.severity = none
# Make public types internal (application, not library)
dotnet_diagnostic.CA1515.severity = none
# Do not name enum values 'Reserved'
dotnet_diagnostic.CA1700.severity = none
# Identifiers should not contain underscores (test names)
dotnet_diagnostic.CA1707.severity = none
# Identifiers should not have incorrect suffix
dotnet_diagnostic.CA1711.severity = none
# Identifiers should not match keywords
dotnet_diagnostic.CA1716.severity = none
# Type names should not match namespaces
dotnet_diagnostic.CA1724.severity = none
# Avoid uninstantiated internal classes (DI-created)
dotnet_diagnostic.CA1812.severity = none
# Properties should not return arrays
dotnet_diagnostic.CA1819.severity = none
# Mark members as static
dotnet_diagnostic.CA1822.severity = none
# Use LoggerMessage delegates
dotnet_diagnostic.CA1848.severity = none
# Avoid Enumerable.Any()
dotnet_diagnostic.CA1860.severity = none
# ConfigureAwait (no SynchronizationContext in ASP.NET Core)
dotnet_diagnostic.CA2007.severity = none
# Operator overloads have named alternates
dotnet_diagnostic.CA2225.severity = none
# Collection properties should be read only
dotnet_diagnostic.CA2227.severity = none
# Pass System.Uri objects instead of strings
dotnet_diagnostic.CA2234.severity = none

#### SonarAnalyzer (Sxxxx) ####

# URIs should not be hardcoded
dotnet_diagnostic.S1075.severity = none
# Utility classes should not have public constructors
dotnet_diagnostic.S1118.severity = none
# Classes should not be empty
dotnet_diagnostic.S2094.severity = none
# Loops should be simplified with LINQ
dotnet_diagnostic.S3267.severity = none
# Make method static (duplicate of CA1822)
dotnet_diagnostic.S2325.severity = none
# Method overloads should be grouped together
dotnet_diagnostic.S4136.severity = none
# Use collection-specific Exists over Any
dotnet_diagnostic.S6605.severity = none
